---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Markdown from "../../components/misc/Markdown.astro";
import NoteMeta from "../../components/NoteMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedNotes, type NoteEntry } from "../../utils/content-utils";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import { getNoteUrlBySlug, url } from "../../utils/url-utils";

type NoteNavigation = NoteEntry | null;

export const getStaticPaths = (async () => {
	const notes = await getSortedNotes();
	return notes.map((entry, index) => ({
		params: { slug: entry.slug },
		props: {
			entry,
			newer: index > 0 ? notes[index - 1] : null,
			older: index < notes.length - 1 ? notes[index + 1] : null,
		},
	}));
}) satisfies GetStaticPaths;

const { entry, newer, older } = Astro.props as {
	entry: NoteEntry;
	newer: NoteNavigation;
	older: NoteNavigation;
};
const { Content, headings } = await entry.render();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "TechArticle",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	dateCreated: formatDateToYYYYMMDD(entry.data.created),
	dateModified: formatDateToYYYYMMDD(entry.data.updated),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
---

<MainGridLayout title={entry.data.title} description={entry.data.description} setOGTypeArticle={true} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <article class="card-base rounded-[var(--radius-large)] px-6 md:px-9 pt-6 pb-7">
        <a href={url("/notes/")} class="inline-flex items-center gap-1 text-sm text-50 hover:text-[var(--primary)] transition mb-5">
            <Icon name="material-symbols:arrow-back-rounded" class="text-lg"></Icon>
            返回笔记
        </a>

        <h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title" class="text-3xl md:text-[2.25rem]/[2.75rem] font-bold text-90 mb-4">
            {entry.data.title}
        </h1>

        <NoteMeta
            created={entry.data.created}
            updated={entry.data.updated}
            tags={entry.data.tags}
            category={entry.data.category}
            class="mb-7"
        />

        <Markdown class="markdown-content">
            <Content />
        </Markdown>
    </article>

    {(newer || older) && <div class="flex flex-col md:flex-row justify-between gap-4">
        {newer ? <a href={getNoteUrlBySlug(newer.slug)} class="btn-card rounded-2xl w-full min-h-[3.75rem] px-4 flex items-center gap-3 active:scale-95">
            <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
            <span class="overflow-hidden text-ellipsis whitespace-nowrap text-black/75 dark:text-white/75">{newer.data.title}</span>
        </a> : <div class="w-full"></div>}
        {older ? <a href={getNoteUrlBySlug(older.slug)} class="btn-card rounded-2xl w-full min-h-[3.75rem] px-4 flex items-center justify-end gap-3 active:scale-95">
            <span class="overflow-hidden text-ellipsis whitespace-nowrap text-black/75 dark:text-white/75">{older.data.title}</span>
            <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
        </a> : <div class="w-full"></div>}
    </div>}
</MainGridLayout>
