---
import { type CollectionEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { GetStaticPaths } from "astro";
import NoteMeta from "../../components/NoteMeta.astro";
import {
	getNotesUrl,
	getNoteUrl,
	getSortedNotes,
	type NoteEntry,
} from "../../utils/notes";

type NoteNavigation = NoteEntry | null;

export const getStaticPaths = (async () => {
	const notes = await getSortedNotes();
	return notes.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			newer: index > 0 ? notes[index - 1] : null,
			older: index < notes.length - 1 ? notes[index + 1] : null,
		},
	}));
}) satisfies GetStaticPaths;

const { entry, newer, older } = Astro.props as {
	entry: CollectionEntry<"notes">;
	newer: NoteNavigation;
	older: NoteNavigation;
};
const { Content, headings } = await render(entry);
---

<MainGridLayout
	title={entry.data.title}
	description={entry.data.description}
	setOGTypeArticle={true}
	headings={headings}
>
	<Card variant="elevated" class="p-6 md:p-8">
		<a
			href={getNotesUrl()}
			class="mb-5 inline-flex items-center gap-2 text-sm text-[var(--on-surface-variant)] transition hover:text-[var(--primary)]"
		>
			<span aria-hidden="true">←</span>
			返回笔记
		</a>

		<h1
			data-pagefind-body
			data-pagefind-weight="10"
			data-pagefind-meta="title"
			class="text-3xl font-bold text-[var(--on-surface)] md:text-[2.25rem]/[2.75rem]"
		>
			{entry.data.title}
		</h1>

		<NoteMeta
			created={entry.data.created}
			updated={entry.data.updated}
			tags={entry.data.tags}
			category={entry.data.category}
			class="mt-5"
		/>

		<Markdown class="mt-7">
			<Content />
		</Markdown>
	</Card>

	{(newer || older) && (
		<div class="flex flex-col justify-between gap-4 md:flex-row">
			{newer ? (
				<a
					href={getNoteUrl(newer.id)}
					class="m3-card m3-card--elevated flex min-h-15 w-full items-center gap-3 p-4 transition hover:-translate-y-0.5"
				>
					<span class="text-2xl text-[var(--primary)]" aria-hidden="true">←</span>
					<span class="truncate text-[var(--on-surface)]">{newer.data.title}</span>
				</a>
			) : (
				<div class="w-full" />
			)}
			{older ? (
				<a
					href={getNoteUrl(older.id)}
					class="m3-card m3-card--elevated flex min-h-15 w-full items-center justify-end gap-3 p-4 text-right transition hover:-translate-y-0.5"
				>
					<span class="truncate text-[var(--on-surface)]">{older.data.title}</span>
					<span class="text-2xl text-[var(--primary)]" aria-hidden="true">→</span>
				</a>
			) : (
				<div class="w-full" />
			)}
		</div>
	)}
</MainGridLayout>
