---
import type { CollectionEntry } from "astro:content";
import Chip from "@components/atoms/action/Chip.astro";
import Card from "@components/atoms/display/Card.svelte";
import { getNoteUrl } from "../utils/notes";
import NoteMeta from "./NoteMeta.astro";

interface Props {
	entry: CollectionEntry<"notes">;
	class?: string;
	style?: string;
}

const { entry, class: className, style } = Astro.props;
const statusLabels: Record<string, string> = {
	seed: "Seed",
	learning: "学习中",
	reviewed: "已复盘",
	stable: "稳定",
};
---

<Card variant="elevated" class={className}>
	<div class="px-6 py-6 md:px-8" style={style}>
		<a
			href={getNoteUrl(entry.id)}
			class="group block text-2xl font-bold text-[var(--on-surface)] transition hover:text-[var(--primary)]"
		>
			{entry.data.title}
			<span class="ml-2 text-[var(--primary)] opacity-0 transition group-hover:opacity-100">→</span>
		</a>

		<NoteMeta
			created={entry.data.created}
			updated={entry.data.updated}
			tags={entry.data.tags}
			category={entry.data.category}
			class="mt-4"
		/>

		<p class="mt-4 line-clamp-3 text-[var(--on-surface-variant)]">
			{entry.data.description || "这是一篇正在持续完善的公开笔记。"}
		</p>

		<Chip variant="tonal" class="mt-4" label={statusLabels[entry.data.status]}>
			{statusLabels[entry.data.status]}
		</Chip>
	</div>
</Card>
