---
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import { formatDate } from "../utils/notes";

interface Props {
	class?: string;
	created: Date;
	updated: Date;
	tags: string[];
	category: string;
}

const { created, updated, tags, category, class: className } = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-3 text-sm text-[var(--on-surface-variant)]", className]}>
	<span class="inline-flex items-center gap-2">
		<MetaIcon icon="material-symbols:calendar-today-outline-rounded" />
		<span>创建 {formatDate(created)}</span>
	</span>

	{updated.getTime() !== created.getTime() && (
		<span class="inline-flex items-center gap-2">
			<MetaIcon icon="material-symbols:edit-calendar-outline-rounded" />
			<span>更新 {formatDate(updated)}</span>
		</span>
	)}

	<span class="inline-flex items-center gap-2">
		<MetaIcon icon="material-symbols:book-2-outline-rounded" />
		<span>{category || "未分类"}</span>
	</span>

	{tags.length > 0 && (
		<span class="inline-flex items-center gap-2">
			<MetaIcon icon="material-symbols:tag-rounded" />
			<span>{tags.join(" / ")}</span>
		</span>
	)}
</div>
