filters:
  and:
    - file.ext == "md"
    - file.inFolder("src/content/notes")
properties:
  file.name:
    displayName: 知识笔记
  note.status:
    displayName: 学习状态
  note.draft:
    displayName: 草稿
  note.category:
    displayName: 分类
  note.updated:
    displayName: 更新日期
views:
  - type: table
    name: 公开知识笔记
    order:
      - file.name
      - note.status
      - note.draft
      - note.category
      - note.updated
